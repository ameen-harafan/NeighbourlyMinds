# Copy this file to .env and fill in real values. Never commit .env.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neighborlyminds
DB_USER=
DB_PASSWORD=

# Frontend (these are bundled into the browser, so only public/publishable keys here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Server only
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SITE_ACCESS_PASSWORD=
# Long random value, e.g. `openssl rand -hex 24`. Needed to delete reports.
ADMIN_API_TOKEN=
# Comma separated list of sites allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:5173,https://34-135-219-183.sslip.io
