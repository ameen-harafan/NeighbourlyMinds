FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev || npm install --omit=dev

COPY server.js db.js ./
COPY lib/ ./lib/
COPY public/ ./public/
COPY data/ ./data/

# Run as the built-in non-root user instead of root
USER node

EXPOSE 3000

CMD ["node", "server.js"]
